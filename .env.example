# Upstox OAuth access token. Never commit the real value.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_TIMEOUT_SECONDS=20

# Optional paths/credentials for the research stack.
QLIB_PROVIDER_URI=data/processed/qlib
RDAGENT_REPO_DIR=.vendor/RD-Agent
QLIB_REPO_DIR=.vendor/qlib

# Keep this false until the whole validation and paper-trading process is complete.
KALVEX_LIVE_TRADING_ENABLED=false
